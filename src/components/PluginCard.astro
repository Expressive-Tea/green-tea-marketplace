---
import Runtimes from './Runtimes.astro';

interface Props {
  slug: string;
  name: string;
  description: string;
  repo: string;
  version: string;
  npm?: string;
  jsr?: string;
  runtimes: string[];
  internal: boolean;
}

const { slug, name, description, repo, version, npm, jsr, runtimes, internal } = Astro.props;
---

<article class="card">
  <span class="version">{version}</span>
  <h2><a class="card__link" href={`/plugins/${slug}/`}>{name}</a></h2>

  <Runtimes runtimes={runtimes} internal={internal} />

  <p>{description}</p>

  <p class="links">
    {npm && <a href={`https://www.npmjs.com/package/${npm}`}>npm</a>}
    {jsr && <a href={`https://jsr.io/${jsr}`}>JSR</a>}
    <a href={repo}>source</a>
  </p>

  {
    internal && (
      <p class="why">
        <a href={`${repo}#runtimes`}>why not the others</a>
      </p>
    )
  }
</article>
