---
import Icon from './Icon.astro';

// A footer of its own, not a breadcrumb back to a parent site. This listing is a separate process
// with its own review loop and its own deploy day, so it closes itself rather than handing the
// reader off mid-sentence.
const linkColumns = [
  {
    heading: 'This listing',
    links: [
      { label: 'Add your plugin', href: '/plugins/#contribute', external: false },
      {
        label: 'Source',
        href: 'https://github.com/Expressive-Tea/green-tea-marketplace',
        external: true,
        icon: 'github' as const,
      },
    ],
  },
  {
    heading: 'Green Tea',
    links: [
      { label: 'Site', href: 'https://green-tea.expressive-tea.io', external: true },
      { label: 'Docs', href: 'https://green-tea.expressive-tea.io/docs', external: true },
      { label: 'npm', href: 'https://www.npmjs.com/package/@green-tea/core', external: true, icon: 'npm' as const },
      { label: 'JSR', href: 'https://jsr.io/@green-tea/core', external: true, icon: 'jsr' as const },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__wordmark">
        Green Tea<span class="site-footer__dot">.</span>
        <span class="site-footer__section">plugins</span>
      </span>
      <p class="site-footer__tagline">
        Every version and runtime here is read from npm and JSR, never typed in.
      </p>
      <p class="site-footer__byline">by the Expressive Tea Team</p>
    </div>

    <nav class="site-footer__columns" aria-label="Footer">
      {
        linkColumns.map((column) => (
          <div class="site-footer__column">
            <p class="site-footer__heading">{column.heading}</p>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a
                    class={link.icon ? 'site-footer__link--mark' : undefined}
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                  >
                    {link.icon && <Icon name={link.icon} size={15} />}
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="wrap site-footer__bottom">
    <p>© {year} Expressive Tea Team · MIT · That's the tea. 🍵</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid color-mix(in srgb, var(--panel) 80%, var(--base));
    background: var(--panel);
    padding-block: clamp(2.5rem, 6vw, 4rem) 1.5rem;
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .site-footer__wordmark {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--matcha);
  }

  .site-footer__dot {
    color: var(--violet);
  }

  .site-footer__section {
    font-weight: 500;
    color: var(--ink);
  }

  .site-footer__tagline {
    color: var(--dim);
    margin: 0.6em 0 0;
    max-width: 30ch;
  }

  .site-footer__byline {
    color: var(--matcha);
    margin: 0.35em 0 0;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .site-footer__columns {
    display: flex;
    gap: 3.5rem;
  }

  .site-footer__heading {
    color: var(--ink);
    font-weight: 600;
    margin: 0 0 0.75em;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .site-footer__column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .site-footer__column a {
    color: var(--dim);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .site-footer__column a:hover,
  .site-footer__column a:focus-visible {
    color: var(--matcha);
  }

  .site-footer__bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--base) 60%, var(--panel));
  }

  .site-footer__bottom p {
    margin: 0;
    color: var(--dim);
    font-size: 0.875rem;
  }

  /* Icon beside the word, never instead of it. A footer is scanned, and a column of bare glyphs
     makes the reader stop and decode where they were skimming. */
  .site-footer__link--mark {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  @media (max-width: 560px) {
    .site-footer__columns {
      gap: 2rem;
    }
  }
</style>
