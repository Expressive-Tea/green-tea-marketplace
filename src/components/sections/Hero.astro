---
import { Code } from 'astro:components';
import { ADD_URL } from '../../links';

// A whole plugin, written against the real `Plugin` type in core (src/plugin.ts). If that type
// changes, this has to change with it — it is the first thing a plugin author reads.
const SAMPLE = `import type { Plugin } from '@green-tea/core';

export function greeting(text = 'hello'): Plugin {
  return {
    name: 'greeting',
    mount({ scope }) {
      scope.add({
        kind: 'provider',
        name: 'greeting',
        needs: [],
        provides: ['greeting'],
        run: () => ({ greeting: text }),
      });
    },
  };
}`;
---

<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__content">
      <p class="kicker">Green Tea. plugins</p>
      <h1>Write it once. It mounts in any <span class="nowrap">green-tea</span> app.</h1>
      <p class="hero__lead">
        A plugin is a name and a mount function. It adds providers and steps to the graph, and
        green-tea figures out where they run. Publish it to JSR or npm, list it here, and it gets a
        page of its own.
      </p>
      <p class="hero__actions">
        <a class="button button--solid" href={ADD_URL}>Add your plugin</a>
        <a class="button button--ghost" href="#plugins">Browse plugins</a>
      </p>
      <p class="hero__micro">Node · Deno · Bun · workerd</p>
    </div>

    <figure class="hero__code" aria-label="A complete plugin">
      <figcaption>greeting.ts</figcaption>
      <Code code={SAMPLE} lang="ts" theme="github-dark" />
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    align-items: center;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.3rem);
    line-height: 1.15;
    margin: 0 0 18px;
    letter-spacing: -0.01em;
  }

  .hero__lead {
    color: var(--dim);
    max-width: 52ch;
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin: 1.75rem 0 1.25rem;
  }

  .hero__micro {
    margin: 0;
    color: var(--dim);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
  }

  .hero__code {
    margin: 0;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 60px -30px rgba(95, 184, 138, 0.35);
  }

  .hero__code figcaption {
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .hero__code :global(pre) {
    margin: 0;
    padding: 16px 18px;
    background: transparent !important;
    font-size: 0.8rem;
    line-height: 1.65;
    overflow-x: auto;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
