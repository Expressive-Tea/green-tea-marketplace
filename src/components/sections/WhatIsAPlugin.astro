---
// Every claim here is checked against core: the shape and the three-method API are
// `Plugin`/`PluginApi` in src/plugin.ts, and `mountPlugin` hands over nothing else.
//
// Do NOT claim a plugin cannot replace or remove an app's step. It can: a plugin node that
// provides a token an app step already provides wins in `topoSort`/`subgraphFor` (src/graph.ts,
// `producedBy.set`, last one in), and the app's step drops out of the graph with no error.
// Verified 2026-09-24. Only duplicate node *names* are a boot error.
const points = [
  {
    title: 'One object',
    body: '<code>{ name, mount }</code>. No base class to extend and no lifecycle to learn. <code>mount</code> gets <code>bus.on</code>, <code>scope.add</code> and <code>onShutdown</code>, and that is the whole API.',
  },
  {
    title: 'Core as types only',
    body: 'Plugins import <code>@green-tea/core</code> with <code>import type</code> and keep it out of <code>dependencies</code>, and review checks for it. So installing one does not pull in a second copy of core.',
  },
  {
    title: 'The graph picks the order',
    body: 'Say what your plugin needs and what it provides, and green-tea decides where it runs. The plugin never gets your app: no container, no modules, no <code>emit</code>. Only the three functions above.',
  },
];
---

<section class="section wrap">
  <p class="kicker">The idea</p>
  <h2>What's a plugin, and why write one?</h2>

  <div class="points">
    {
      points.map((point, i) => (
        <article class="point">
          <span class="point__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{point.title}</h3>
          <p set:html={point.body} />
        </article>
      ))
    }
  </div>
</section>

<style>
  .points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .point {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 22px 24px;
  }

  .point__n {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--violet);
  }

  .point h3 {
    margin: 6px 0 10px;
    font-size: 1.15rem;
  }

  .point p {
    margin: 0;
    color: var(--dim);
    line-height: 1.65;
  }

  .point :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    color: var(--matcha);
  }
</style>
